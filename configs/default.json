{
  "diffusion": {
    "timesteps": 1000,
    "noise_schedule_type": "cosine",
    "prediction_target": "epsilon",
    "seed": 42,
    "device": "cuda"
  },
  "unet": {
    "image_size": 64,
    "in_channels": 3,
    "out_channels": 3,
    "base_channels": 128,
    "channel_mults": [1, 2, 2, 4],
    "num_res_blocks": 2,
    "attention_resolutions": [16, 8],
    "dropout": 0.1,
    "time_dim": 512,
    "cond_dim": 512,
    "num_groups": 32,
    "use_scale_shift_norm": true
  },
  "condition": {
    "num_animals": 10,
    "num_objects": 10,
    "num_pairs": 100,
    "cond_dim": 512,
    "animal_emb_dim": 256,
    "object_emb_dim": 256,
    "pair_emb_dim": 512,
    "cond_dropout_prob": 0.1
  },
  "training": {
    "batch_size": 128,
    "gradient_accumulation_steps": 1,
    "learning_rate": 0.0002,
    "weight_decay": 0.0001,
    "optimizer_type": "AdamW",
    "betas": [0.9, 0.999],
    "max_steps": 150000,
    "warmup_steps": 5000,
    "gradient_clip": 1.0,
    "ema_decay": 0.9999,
    "mixed_precision_dtype": "bf16",
    "use_tf32": true,
    "use_ema": true,
    "num_workers": 8,
    "pin_memory": true,
    "persistent_workers": true
  },
  "sampling": {
    "sampling_method": "ddim",
    "ddim_steps": 50,
    "cfg_scale": 1.5,
    "seed": 42
  },
  "dataset": {
    "train_csv": "data/train.csv",
    "generate_csv": "data/generate.csv",
    "image_dir": "data/images",
    "image_size": 64,
    "normalize_mean": 0.5,
    "normalize_std": 0.5,
    "augmentation_hflip": true
  },
  "checkpoint_dir": "checkpoints",
  "sample_preview_dir": "samples",
  "log_dir": "runs/hw6",
  "save_every": 10000,
  "sample_every": 5000,
  "log_every": 100,
  "use_wandb": false,
  "wandb_project": "hw6-brainrot",
  "wandb_name": "baseline-v1"
}
